---
import { SITE_NAME, SITE_DESCRIPTION, TOOLS, CATEGORIES, toolsByCategory, withBase, absolute } from '../config/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  path: string; // site-relative path of this page, e.g. '/tool/json-formatter/'
}
const { title, description = SITE_DESCRIPTION, path } = Astro.props;
const canonical = absolute(path);
const fullTitle = title === SITE_NAME ? `${SITE_NAME} — Free Developer & Text Tools, 100% in Your Browser` : `${title} · ${SITE_NAME}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#0d1117" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='18' fill='%230d1117'/%3E%3Ctext x='50' y='70' font-size='58' text-anchor='middle' fill='%233fb950' font-family='monospace' font-weight='bold'%3E%3E_%3C/text%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href={withBase('/')}><span class="prompt">&gt;</span> textkit<span class="cursor"></span></a>
        <nav class="main-nav">
          <a href={withBase('/tools/')}>Tools</a>
          <a href={withBase('/guides/')}>Guides</a>
          <a href={withBase('/about/')}>About</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          {CATEGORIES.map((cat) => (
            <div>
              <h4>{cat}</h4>
              <ul>
                {toolsByCategory(cat).map((t) => (
                  <li><a href={withBase(`/tool/${t.slug}/`)}>{t.name}</a></li>
                ))}
              </ul>
            </div>
          ))}
          <div>
            <h4>Site</h4>
            <ul>
              <li><a href={withBase('/tools/')}>All tools</a></li>
              <li><a href={withBase('/guides/')}>Guides</a></li>
              <li><a href={withBase('/about/')}>About</a></li>
              <li><a href={withBase('/contact/')}>Contact</a></li>
              <li><a href={withBase('/privacy/')}>Privacy policy</a></li>
              <li><a href={withBase('/disclaimer/')}>Disclaimer</a></li>
            </ul>
          </div>
        </div>
        <p class="footer-note">
          {SITE_NAME} · {TOOLS.length} tools · every tool runs locally in your browser — nothing you type or paste is uploaded. · Example build.
        </p>
      </div>
    </footer>
  </body>
</html>
