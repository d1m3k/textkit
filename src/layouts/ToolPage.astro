---
import Base from './Base.astro';
import { SITE_NAME, withBase, absolute, type Tool } from '../config/site';

interface Props { tool: Tool; related: Tool[] }
const { tool, related } = Astro.props;
const pageUrl = absolute(`/tool/${tool.slug}/`);

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: `${tool.name} — ${SITE_NAME}`,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any (browser)',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description: tool.short,
  url: pageUrl,
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tool.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const crumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absolute('/') },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: absolute('/tools/') },
    { '@type': 'ListItem', position: 3, name: tool.name, item: pageUrl },
  ],
};
---

<Base title={tool.name} description={tool.short} path={`/tool/${tool.slug}/`}>
  <Fragment slot="head">
    <meta name="keywords" content={tool.keywords} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(crumbsLd)} />
  </Fragment>

  <nav class="breadcrumb">
    <a href={withBase('/')}>home</a> / <a href={withBase('/tools/')}>tools</a> / <span>{tool.slug}</span>
  </nav>

  <h1>{tool.name}</h1>
  <p style="color:var(--muted);max-width:720px">{tool.long[0]}</p>

  <div class="win" style="margin:26px 0">
    <div class="win-bar">
      <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
      <span class="win-title">textkit — {tool.slug}</span>
    </div>
    <div class="win-body">
      <slot />
    </div>
  </div>

  <div class="prose">
    <h2>How to use it</h2>
    <ol class="steps">
      {tool.steps.map((s) => <li>{s}</li>)}
    </ol>

    <h2>About this tool</h2>
    {tool.long.map((p) => <p>{p}</p>)}
    <p>
      Like every TextKit tool, the {tool.name} runs entirely on your device. There is no
      account, no upload and no tracking of the content you process — close the tab and
      everything is gone.
    </p>

    <h2>Frequently asked questions</h2>
    {tool.faqs.map((f) => (
      <details class="faq">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>

  <h2>Related tools</h2>
  <div class="card-grid">
    {related.map((t) => (
      <a class="tool-card" href={withBase(`/tool/${t.slug}/`)}>
        <h3>{t.name}</h3>
        <p>{t.short}</p>
      </a>
    ))}
  </div>
</Base>
