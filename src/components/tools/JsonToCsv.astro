---
---
<div>
  <label for="jc-in">JSON array of objects</label>
  <textarea id="jc-in" placeholder='Paste JSON here, e.g. an array of objects…' spellcheck="false"></textarea>
  <div class="btnrow">
    <button class="btn" id="jc-convert">Convert to CSV</button>
    <button class="btn ghost" id="jc-sample">Load sample</button>
    <button class="btn ghost" id="jc-clear">Clear</button>
  </div>
  <div class="status" id="jc-status">Waiting for input.</div>
  <label for="jc-out" style="margin-top:16px">CSV result</label>
  <textarea id="jc-out" readonly placeholder="CSV appears here…" spellcheck="false"></textarea>
  <div class="btnrow">
    <button class="btn amber" id="jc-copy">Copy CSV</button>
    <button class="btn ghost" id="jc-download">Download .csv</button>
  </div>
</div>

<script>
  import { jsonToCsv } from '../../lib/logic.js';
  const $ = (id) => document.getElementById(id);
  const input = $('jc-in'), out = $('jc-out'), status = $('jc-status');
  $('jc-convert').addEventListener('click', () => {
    const text = input.value.trim();
    if (!text) { status.className = 'status'; status.textContent = 'Paste some JSON first.'; return; }
    try {
      out.value = jsonToCsv(text);
      const rows = out.value.split('\n').length - 1;
      status.className = 'status ok';
      status.textContent = `✓ Converted — ${rows} data row${rows === 1 ? '' : 's'}.`;
    } catch (e) {
      status.className = 'status err';
      status.textContent = '✗ ' + e.message;
    }
  });
  $('jc-sample').addEventListener('click', () => {
    input.value = '[{"name":"Ada","role":"engineer","score":91},{"name":"Bima","role":"designer","score":87,"team":"product"},{"name":"Citra","role":"engineer","score":95}]';
  });
  $('jc-clear').addEventListener('click', () => { input.value = ''; out.value = ''; status.className = 'status'; status.textContent = 'Waiting for input.'; });
  $('jc-copy').addEventListener('click', async () => { if (out.value) await navigator.clipboard.writeText(out.value); });
  $('jc-download').addEventListener('click', () => {
    if (!out.value) return;
    const url = URL.createObjectURL(new Blob([out.value], { type: 'text/csv' }));
    const a = document.createElement('a');
    a.href = url; a.download = 'textkit-export.csv'; a.click();
    URL.revokeObjectURL(url);
  });
</script>
