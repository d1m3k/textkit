---
---
<div>
  <div class="grid2">
    <div>
      <label for="pw-length">Length: <span id="pw-length-val">16</span> characters</label>
      <input type="range" id="pw-length" min="6" max="64" value="16" style="width:100%;accent-color:var(--green)" />
    </div>
    <div>
      <label for="pw-count">How many passwords?</label>
      <input type="number" id="pw-count" value="3" min="1" max="50" />
    </div>
  </div>
  <div style="display:flex;gap:22px;flex-wrap:wrap;margin:14px 0">
    <label class="check"><input type="checkbox" id="pw-lower" checked /> a–z</label>
    <label class="check"><input type="checkbox" id="pw-upper" checked /> A–Z</label>
    <label class="check"><input type="checkbox" id="pw-digits" checked /> 0–9</label>
    <label class="check"><input type="checkbox" id="pw-symbols" checked /> Symbols</label>
    <label class="check"><input type="checkbox" id="pw-noambig" /> Exclude look-alikes (I, l, 1, O, 0)</label>
  </div>
  <div class="status" id="pw-entropy">Entropy: — bits</div>
  <div class="btnrow">
    <button class="btn" id="pw-gen">Generate passwords</button>
    <button class="btn amber" id="pw-copy">Copy all</button>
  </div>
  <label for="pw-out">Generated passwords</label>
  <textarea id="pw-out" readonly placeholder="Your passwords appear here…" spellcheck="false" style="min-height:110px"></textarea>
  <p style="font-family:var(--mono);font-size:.88rem;color:var(--muted)">Generated locally with crypto-grade randomness. Nothing is sent or stored — save the one you use in a password manager.</p>
</div>

<script>
  import { passwordGen, passwordEntropy } from '../../lib/logic.js';
  const $ = (id) => document.getElementById(id);
  function opts() {
    return {
      length: parseInt($('pw-length').value, 10),
      lower: $('pw-lower').checked, upper: $('pw-upper').checked,
      digits: $('pw-digits').checked, symbols: $('pw-symbols').checked,
      excludeAmbiguous: $('pw-noambig').checked,
    };
  }
  function gen() {
    const o = opts();
    $('pw-length-val').textContent = o.length;
    const bits = passwordEntropy(o);
    const label = bits >= 100 ? 'excellent' : bits >= 80 ? 'strong' : bits >= 60 ? 'decent' : 'weak — increase length or sets';
    $('pw-entropy').className = 'status ' + (bits >= 60 ? 'ok' : 'err');
    $('pw-entropy').textContent = `Entropy: ${bits} bits (${label}) per password`;
    let n = parseInt($('pw-count').value, 10);
    if (!Number.isFinite(n)) n = 3;
    n = Math.min(50, Math.max(1, n));
    try {
      $('pw-out').value = Array.from({ length: n }, () => passwordGen(o)).join('\n');
    } catch (e) {
      $('pw-out').value = '';
      $('pw-entropy').className = 'status err';
      $('pw-entropy').textContent = '✗ ' + e.message;
    }
  }
  $('pw-gen').addEventListener('click', gen);
  ['pw-length', 'pw-lower', 'pw-upper', 'pw-digits', 'pw-symbols', 'pw-noambig'].forEach((id) =>
    $(id).addEventListener('input', gen));
  $('pw-copy').addEventListener('click', async () => { const v = $('pw-out').value; if (v) await navigator.clipboard.writeText(v); });
  gen();
</script>
